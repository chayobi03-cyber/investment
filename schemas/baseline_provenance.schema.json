{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "as_of_date", "purpose", "canonical_policy", "series", "promotion_requirements"],
  "properties": {
    "schema_version": {"type": "string"},
    "as_of_date": {"type": "string", "format": "date"},
    "purpose": {"type": "string"},
    "canonical_policy": {
      "type": "object",
      "required": ["market_ohlc", "research_return_input", "vendor_adjusted_close", "outlier_policy", "missing_duplicate_policy", "point_in_time_policy", "cross_source_policy"],
      "additionalProperties": {"type": "string"}
    },
    "series": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["series_id", "instrument", "issuer", "role", "currency", "exchange", "primary_source", "secondary_source", "adjustment_rule", "known_anomalies", "pit_rule"],
        "properties": {
          "series_id": {"type": "string", "pattern": "^[A-Z0-9]+$"},
          "instrument": {"type": "string"},
          "issuer": {"type": "string"},
          "role": {"type": "string"},
          "currency": {"type": "string"},
          "exchange": {"type": "string"},
          "inception_or_start": {"type": "string"},
          "primary_source": {
            "type": "object",
            "required": ["provider", "url", "source_type", "required_fields"],
            "properties": {
              "provider": {"type": "string"},
              "url": {"type": "string", "format": "uri"},
              "source_type": {"const": "official_issuer"},
              "required_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          },
          "secondary_source": {
            "type": "object",
            "required": ["provider", "url", "source_type"],
            "properties": {
              "provider": {"type": "string"},
              "url": {"type": "string", "format": "uri"},
              "source_type": {"type": "string"}
            }
          },
          "adjustment_rule": {"type": "object", "required": ["split_events", "cash_distributions", "return_formula", "vendor_adjusted_close"]},
          "known_anomalies": {"type": "array", "items": {"type": "object"}},
          "pit_rule": {"type": "string", "minLength": 20}
        }
      }
    },
    "promotion_requirements": {"type": "object", "required": ["series_count", "m1b_green_requires"]}
  }
}
