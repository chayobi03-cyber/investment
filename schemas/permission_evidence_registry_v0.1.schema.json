{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chayobi03-cyber/investment/blob/main/schemas/permission_evidence_registry_v0.1.schema.json",
  "title": "Permission Evidence Registry V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "decision_clock",
    "families",
    "global_controls"
  ],
  "properties": {
    "schema_version": {
      "const": "permission-evidence-registry-v0.1"
    },
    "status": {
      "const": "SCHEMA_DEFINED_NOT_VALIDATED"
    },
    "decision_clock": {
      "const": "UTC_daily_close"
    },
    "global_controls": {},
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "required",
          "availability_policy",
          "datasets"
        ],
        "properties": {
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "const": true
          },
          "availability_policy": {
            "enum": [
              "SOURCE_RELEASE_TIMESTAMP",
              "EXCHANGE_OBSERVATION_TIMESTAMP",
              "EXPLICIT_AVAILABLE_AT"
            ]
          },
          "datasets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dataset_id",
                "asset_scope",
                "series",
                "primary_sources"
              ],
              "properties": {
                "dataset_id": {
                  "type": "string",
                  "minLength": 1
                },
                "asset_scope": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "series": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "series_id",
                      "unit",
                      "available_at_required"
                    ],
                    "properties": {
                      "series_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      },
                      "available_at_required": {
                        "const": true
                      }
                    }
                  }
                },
                "primary_sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_id",
                      "source_class",
                      "role"
                    ],
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_class": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "enum": [
                          "PRIMARY",
                          "FALLBACK",
                          "ARCHIVE"
                        ]
                      },
                      "credential_required": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
